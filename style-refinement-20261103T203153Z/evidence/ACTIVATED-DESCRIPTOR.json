      "displayOptions": {
        "show": {
          "resource": [
            "speech"
          ]
        }
      },
      "options": [
        {
          "displayName": "Custom Style Instructions",
          "name": "styleInstructions",
          "type": "string",
          "typeOptions": {
            "rows": 3
          },
          "default": "",
          "placeholder": "e.g. Speak warmly with a calm, confident delivery",
          "description": "Delivery instructions, not spoken text. Available for supported TTS models over HTTP; leave blank for normal delivery. Combined input limits apply.",
          "displayOptions": {
            "show": {
              "/operation": [
                "textToSpeech"
              ],
              "/additionalOptions.apiModel.value": [
                "voicely-flash-v1",
                "voicely-tts-classic-pro-v1",
                "voicely-tts-preview-v1",
                "voicely-tts-narration-v1",
                "voicely-tts-narration-lite-v1",
                "voicely-tts-classic-lite-v1",
                {
                  "_cnd": {
                    "startsWith": "="
                  }
                }
              ]
            },
            "hide": {
              "/options.speechTransport": [
                "websocket"
              ],
              "/speechTransport": [
                "websocket"
              ]
            }
          }
        },
        {
          "displayName": "Custom Style Strength",
          "name": "styleStrength",
          "type": "string",
          "default": "",
          "description": "Custom model only: enter a number from 0 to 1 or use an expression. Leave empty for the service default. Fixed presets refuse this override.",
          "displayOptions": {
            "show": {
              "/operation": [
                "speechToSpeech"
              ]
            }
          }
        },
        {
          "displayName": "Diarize",
          "name": "diarize",
          "type": "boolean",
          "default": true,
          "displayOptions": {
            "show": {
              "/operation": [
                "speechToText"
              ]
            }
          }
        },
        {
          "displayName": "Language",
          "name": "language",
          "type": "resourceLocator",
          "default": {
            "mode": "list",
            "value": ""
          },
          "displayOptions": {
            "show": {
              "/operation": [
                "textToSpeech"
              ]
            }
          },
          "description": "Choose Model first, then a supported language. Preview marks Voicely testing status. Blank keeps existing automatic language behavior.",
          "typeOptions": {
            "loadOptionsDependsOn": [
              "additionalOptions.apiModel",
              "additionalOptions.model",
              "operation"
