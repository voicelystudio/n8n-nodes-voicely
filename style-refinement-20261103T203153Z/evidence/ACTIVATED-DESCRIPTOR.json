{
  "displayName": "Voicely Studio",
  "group": [
    "transform"
  ],
  "subtitle": "={{$parameter[\"operation\"] + \": \" + $parameter[\"resource\"]}}",
  "version": 2,
  "description": "Speech, voices, agents and call automation with Voicely",
  "defaults": {
    "name": "Voicely Studio"
  },
  "inputs": [
    "main"
  ],
  "outputs": [
    "main"
  ],
  "usableAsTool": true,
  "credentials": [
    {
      "name": "voicelySuiteApi",
      "required": true,
      "displayOptions": {
        "show": {
          "resource": [
            "language",
            "model",
            "speech",
            "voice"
          ]
        }
      }
    },
    {
      "name": "voicelyAutomationApi",
      "required": true,
      "displayOptions": {
        "show": {
          "resource": [
            "agent",
            "call",
            "delivery",
            "subscription",
            "tool"
          ]
        }
      }
    }
  ],
