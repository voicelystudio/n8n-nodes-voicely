{
	"name": "@voicelystudio/n8n-nodes-voicely",
	"version": "0.1.1",
	"description": "Voicely text-to-speech integration for n8n workflows",
	"license": "MIT",
	"homepage": "https://tryvoicely.com/text-to-speech-api",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Voicely Studio",
		"email": "administrator@tryvoicely.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/voicelystudio/n8n-nodes-voicely.git"
	},
	"bugs": {
		"url": "https://github.com/voicelystudio/n8n-nodes-voicely/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test test/*.test.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/credentials",
		"dist/nodes"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/VoicelyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Voicely/Voicely.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.0",
		"@types/node": "^20.0.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
